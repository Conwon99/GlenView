---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../sections/Navbar';
import { HeroStats } from '../sections/Hero/components/HeroStats';
import { ExteriorWhyChooseSection } from '../sections/CoreValuesSection/ExteriorWhyChooseSection';
import { RecentJobsSection } from '../sections/RecentJobsSection';
import { ExteriorProcessSection } from '../sections/ProcessSection/ExteriorProcessSection';
import { ExteriorFAQSection } from '../sections/FAQSection/ExteriorFAQSection';
import { ServiceAreasSection } from '../sections/ServiceAreasSection';
import ReviewsSection from '../sections/ReviewsSection.astro';
import { QuoteSection } from '../sections/QuoteSection';
import { FooterSection } from '../sections/FooterSection';
import { getServiceBySlug } from '../data/services';
import { BUSINESS_NAME } from '../constants/site';

const service = getServiceBySlug('render-softwashing')!;
---

<Layout
  title={`${service.title} - ${BUSINESS_NAME} | Central Scotland`}
  description={service.shortDescription}
>
  <div class="min-h-screen bg-neutral-100 font-figtree text-black text-sm leading-5 antialiased">
    <Navbar client:load />
    <main class="pt-0">
      <section class="relative text-white overflow-hidden min-h-screen">
        <div class="absolute inset-0">
          <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style={`background-image: url("${service.imageUrl}");`} />
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent" />
        <div class="relative mx-auto flex min-h-screen w-full max-w-[1204px] flex-col justify-end px-5 pb-8 pt-32 md:px-8 md:pb-12 md:pt-28 supports-[min-height:100dvh]:min-h-[100dvh]">
          <div class="items-start box-border gap-x-10 flex flex-col justify-between gap-y-10 md:items-end md:gap-x-[60px] md:flex-row md:gap-y-[60px] w-full">
            <div class="box-border basis-[0%] grow max-w-[650px] pt-24 md:pt-32">
              <div class="box-border gap-x-4 flex flex-col gap-y-4">
                <h1 class="text-[44px] font-bold box-border tracking-[-1.44px] leading-[52px] md:text-7xl md:leading-[80px] font-heading uppercase">
                  <div>{service.title}</div>
                </h1>
                <p class="text-base leading-[26px] md:text-lg font-figtree">
                  {service.shortDescription}
                </p>
              </div>
              <div class="items-center box-border gap-x-5 flex flex-wrap gap-y-5 mt-6 md:gap-x-6 md:gap-y-6 md:mt-7">
                <a href="/contact/" class="text-white items-center bg-cta box-border gap-x-5 flex max-w-full gap-y-5 text-center border pl-6 pr-1 py-1 rounded-[100px] border-solid border-transparent hover:bg-white hover:border-cta-dark hover:text-black">
                  <span class="relative text-sm font-bold z-[2] md:text-base md:leading-6">GET A FREE QUOTE</span>
                  <span class="text-cta-light items-center bg-white box-border flex h-12 justify-center w-12 overflow-hidden rounded-[50%]">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                  </span>
                </a>
              </div>
            </div>
            <HeroStats client:load />
          </div>
        </div>
      </section>
      <ExteriorWhyChooseSection client:load serviceSlug="render-softwashing" />
      <RecentJobsSection client:load serviceSlug="render-softwashing" />
      <ExteriorProcessSection client:load serviceSlug="render-softwashing" />
      <ExteriorFAQSection client:load serviceSlug="render-softwashing" />
      <ServiceAreasSection client:load />
      <ReviewsSection title="Reviews" />
      <QuoteSection client:load showTerms={false} />
      <FooterSection client:load />
    </main>
  </div>
</Layout>
