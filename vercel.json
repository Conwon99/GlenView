      "permanent": true
    },
    {
      "source": "/:removedTown(bishopbriggs|robroyston|stepps|lenzie|kirkintilloch|auchinloch|chryston|moodiesburn|muirhead|gartcosh|cumbernauld|croy|dullatur|twechar|kilsyth|banton|queenzieburn|coatbridge|airdrie|glenboig|plains|caldercruix|chapelhall|salsburgh|denny|bonnybridge|banknock|haggs|falkirk|camelon|larbert|stenhousemuir|grangemouth|polmont|linlithgow|stirling|bridge-of-allan|dunblane)/:removedService(roof-steam-cleaning|render-softwashing|driveway-cleaning|gutter-cleaning|pvc-white-cleaning|window-cleaning|moss-removal|patio-cleaning){/}?",
